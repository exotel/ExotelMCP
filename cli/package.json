    "bin/",
    "lib/",
    "skills/",
    "README.md"
  ],
  "scripts": {
    "prepack": "node scripts/bundle-skills.js",
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exotel/ExotelMCP.git",
    "directory": "cli"
  },
  "keywords": [
    "exotel",
    "mcp",
    "voice",
    "sms",
    "voicebot",
    "agent",
    "claude",
    "cursor",
    "codex"
  ],
  "homepage": "https://developer.exotel.com/docs/mcp-server/overview",
  "bugs": {
    "url": "https://github.com/exotel/ExotelMCP/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Exotel"
}
